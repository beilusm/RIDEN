<component type="desktop-application">
  <id>io.github.beilusm.ridenps</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>RIDEN Power Supply</name>
  <summary>Desktop control software for RIDEN programmable power supplies</summary>
  <summary xml:lang="zh_CN">RIDEN 数控电源桌面控制软件</summary>
  <developer id="io.github.beilusm">
    <name>beilusm</name>
  </developer>
  <description>
    <p>
      RIDEN Power Supply is a cross-platform desktop application for controlling
      RIDEN programmable power supplies via the Modbus RTU protocol over a
      CH340 USB-to-serial converter (115200 baud, 8N1, device address 0x01).
    </p>
    <p>
      Features include real-time V/A/W waveform display, setpoint adjustment,
      output toggle, OVP/OCP protection monitoring, 10 memory preset slots
      (M0–M9) management, and a schema-driven register viewer for advanced
      diagnostics.
    </p>
  </description>
  <icon type="stock">io.github.beilusm.ridenps</icon>

