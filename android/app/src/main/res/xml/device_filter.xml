<?xml version="1.0" encoding="utf-8"?>
<!--
  CH340 USB-Serial device filter.  When the user plugs a CH340 module
  into the Android device's USB-C / OTG port, the system offers to
  open RIDEN Power Supply; subsequent sessions reuse the granted
  permission without an additional popup.

  IDs:
    VID 0x1A86 = 6790  (decimal)  — QinHeng Electronics (formerly WCH)
    PID 0x7523 = 29987 (decimal)  — CH340 / CH341 USB-Serial bridge

  (Earlier draft had product-id="29723" which is 0x741B — a wrong PID;
  derived from a transcription error in CLAUDE.md.  Phase 4 fix.)
-->
<resources>
    <usb-device
        vendor-id="6790"
        product-id="29987" />
</resources>

